<mxfile host="app.diagrams.net" modified="2026-11-23T13:20:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="atelier-er" name="Diagrama ER"><mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Diagrama ER — Atelierul de Ciocolată&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#4b241b;" vertex="1" parent="1"><mxGeometry x="380" y="15" width="680" height="45" as="geometry" /></mxCell><mxCell id="categorie" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;CATEGORIE&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;PK id_categorie : INT&lt;br&gt;nume : VARCHAR&lt;br&gt;descriere : TEXT&lt;br&gt;culoare : VARCHAR&lt;br&gt;sigla : VARCHAR&lt;br&gt;ordine : INT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#633322;strokeWidth=2;fontColor=#39251f;align=left;verticalAlign=top;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="290" height="210" as="geometry" /></mxCell><mxCell id="produs" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;PRODUS&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;PK id_produs : INT&lt;br&gt;nume : VARCHAR&lt;br&gt;descriere : TEXT&lt;br&gt;pret : DECIMAL&lt;br&gt;gramaj_g : INT&lt;br&gt;procent_cacao : FLOAT&lt;br&gt;tip : ENUM&lt;br&gt;disponibil : BOOLEAN&lt;br&gt;arome : VARCHAR[] (vector)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#633322;strokeWidth=2;fontColor=#39251f;align=left;verticalAlign=top;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="340" height="310" as="geometry" /></mxCell><mxCell id="brand" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;BRAND&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;PK id_brand : INT&lt;br&gt;nume : VARCHAR&lt;br&gt;tara_origine