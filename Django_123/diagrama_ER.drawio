u : INT&lt;br&gt;nume : VARCHAR&lt;br&gt;adresa : VARCHAR&lt;br&gt;telefon : VARCHAR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#633322;strokeWidth=2;fontColor=#39251f;align=left;verticalAlign=top;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="555" width="300" height="175" as="geometry" /></mxCell><mxCell id="e1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c5a3c;strokeWidth=2;startArrow=none;endArrow=none;fontStyle=1;fontColor=#7a3926;" edge="1" parent="1" source="categorie" target="produs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c5a3c;strokeWidth=2;startArrow=none;endArrow=none;fontStyle=1;fontColor=#7a3926;" edge="1" parent="1" source="brand" target="produs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c5a3c;strokeWidth=2;startArrow=none;endArrow=none;fontStyle=1;fontColor=#7a3926;" edge="1" parent="1" source="ambalaj" target="produs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="M : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c5a3c;strokeWidth=2;startArrow=none;endArrow=none;fontStyle=1;fontColor=#7a3926;" edge="1" parent="1" source="produs" target="ingredient"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c5a3c;strokeWidth=2;startArrow=none;endArrow=none;fontStyle=1;fontColor=#7a3926;" edge="1" parent="1" source="produs" target="lot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c5a3c;strokeWidth=2;startArrow=none;endArrow=none;fontStyle=1;fontColor=#7a3926;" edge="1" parent="1" source="sediu" target="lot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nota" value="&lt;b&gt;Relații:&lt;/b&gt; Categorie–Produs (1:N), Brand–Produs (1:N), Ambalaj–Produs (1:N), Produs–Ingredient (M:N), Produs–LotProducție (1:N), Sediu–LotProducție (1:N).&lt;br&gt;&lt;b&gt;Tipuri:&lt;/b&gt; VARCHAR, TEXT, DECIMAL, INT, FLOAT, ENUM, BOOLEAN, DATE. Atributul vectorial este &lt;i&gt;arome&lt;/i&gt;. LotProductie este slabă deoarece depinde de Produs și are cheia compusă id_produs + nr_lot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2e4d7;strokeColor=#b98b6c;fontColor=#39251f;align=left;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1160" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>